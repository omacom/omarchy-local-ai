From 0d33f2798373cf24f058806da473ae2c2d58089a Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson <david@hey.com>
Date: Wed, 18 Nov 2026 16:01:41 +0100
Subject: [PATCH] server: add --api-key and --api-key-file

Without a key the server answers anyone who can reach it. With one, from
--api-key, --api-key-file or SD_API_KEY, every request but a CORS
preflight needs `Authorization: Bearer <key>`, compared in constant
time; others get 401 with an OpenAI-style error. Mirrors llama.cpp's
server options.
---
 examples/server/README.md   |  4 ++++
 examples/server/main.cpp    | 23 ++++++++++++++++++++++-
 examples/server/runtime.cpp | 28 ++++++++++++++++++++++++++++
 examples/server/runtime.h   |  3 +++
 4 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/examples/server/README.md b/examples/server/README.md
index 8673eb8..62b5380 100644
--- a/examples/server/README.md
+++ b/examples/server/README.md
@@ -419,6 +419,10 @@ configured defaults.
 | `--listen-port <port>` | `1234` | Server listen port |
 | `--max-pending-jobs <count>` | `64` | Maximum async jobs queued or generating |
 | `--completed-ttl-seconds <seconds>` | `600` | Retention time for completed async jobs |
+| `--api-key <key>` | none | Require `Authorization: Bearer <key>` on every request; `SD_API_KEY` sets it too |
+| `--api-key-file <path>` | none | Read the required key from a file, keeping it out of the process list |
+
+Without a key the server answers anyone who can reach it, so set one before listening beyond `127.0.0.1`. With one, a request without the right key gets `401` with an OpenAI-style error; CORS preflight requests stay open.
 
 ### Logging
 
diff --git a/examples/server/main.cpp b/examples/server/main.cpp
index 391a1ec..8bb6fae 100644
--- a/examples/server/main.cpp
+++ b/examples/server/main.cpp
@@ -67,6 +67,21 @@ void sd_log_cb(enum sd_log_level_t level, const char* log, void* data) {
     log_print(level, log, svr_params->log_level, svr_params->color);
 }
 
+// Whether the request carries `Authorization: Bearer <key>`, compared in time
+// that doesn't depend on where the first difference is.
+static bool authorized(const httplib::Request& req, const std::string& key) {
+    const std::string header = req.get_header_value("Authorization");
+    const std::string prefix = "Bearer ";
+    if (header.size() != prefix.size() + key.size() || header.compare(0, prefix.size(), prefix) != 0) {
+        return false;
+    }
+    unsigned char difference = 0;
+    for (size_t i = 0; i < key.size(); ++i) {
+        difference |= static_cast<unsigned char>(header[prefix.size() + i] ^ key[i]);
+    }
+    return difference == 0;
+}
+
 int main(int argc, const char** argv) {
     if (argc > 1 && std::string(argv[1]) == "--version") {
         std::cout << version_string() << "\n";
@@ -136,7 +151,7 @@ int main(int argc, const char** argv) {
 
     httplib::Server svr;
 
-    svr.set_pre_routing_handler([](const httplib::Request& req, httplib::Response& res) {
+    svr.set_pre_routing_handler([&svr_params](const httplib::Request& req, httplib::Response& res) {
         std::string origin = req.get_header_value("Origin");
         if (origin.empty()) {
             origin = "*";
@@ -150,6 +165,12 @@ int main(int argc, const char** argv) {
             res.status = 204;
             return httplib::Server::HandlerResponse::Handled;
         }
+        if (!svr_params.api_key.empty() && !authorized(req, svr_params.api_key)) {
+            res.status = 401;
+            res.set_content(R"({"error":{"message":"Invalid API key","type":"authentication_error","code":"invalid_api_key"}})",
+                            "application/json");
+            return httplib::Server::HandlerResponse::Handled;
+        }
         return httplib::Server::HandlerResponse::Unhandled;
     });
 
diff --git a/examples/server/runtime.cpp b/examples/server/runtime.cpp
index 6ac3866..94c58ae 100644
--- a/examples/server/runtime.cpp
+++ b/examples/server/runtime.cpp
@@ -6,6 +6,7 @@
 #include <cmath>
 #include <cstdlib>
 #include <filesystem>
+#include <fstream>
 #include <mutex>
 #include <regex>
 #include <sstream>
@@ -370,6 +371,8 @@ ArgOptions SDSvrParams::get_options() {
     options.string_options = {
         {"-l", "--listen-ip", "server listen ip (default: 127.0.0.1)", 0, &listen_ip},
         {"", "--serve-html-path", "path to HTML file to serve at root (optional)", 0, &serve_html_path},
+        {"", "--api-key", "require this key as a bearer token on every request (default: none, or SD_API_KEY)", 0, &api_key},
+        {"", "--api-key-file", "require the key in this file as a bearer token on every request", 0, &api_key_file},
     };
 
     options.int_options = {
@@ -407,6 +410,30 @@ ArgOptions SDSvrParams::get_options() {
 }
 
 bool SDSvrParams::validate() {
+    if (!api_key.empty() && !api_key_file.empty()) {
+        LOG_ERROR("error: use --api-key or --api-key-file, not both");
+        return false;
+    }
+    if (!api_key_file.empty()) {
+        std::ifstream file(api_key_file);
+        std::stringstream contents;
+        contents << file.rdbuf();
+        const std::string text = contents.str();
+        const auto first       = text.find_first_not_of(" \t\r\n");
+        const auto last        = text.find_last_not_of(" \t\r\n");
+        api_key                = first == std::string::npos ? "" : text.substr(first, last - first + 1);
+        if (!file || api_key.empty()) {
+            LOG_ERROR("error: no API key could be read from %s", api_key_file.c_str());
+            return false;
+        }
+    }
+    // The environment keeps the key out of the process list.
+    if (api_key.empty()) {
+        if (const char* key = std::getenv("SD_API_KEY"); key != nullptr) {
+            api_key = key;
+        }
+    }
+
     if (listen_ip.empty()) {
         LOG_ERROR("error: the following arguments are required: listen_ip");
         return false;
@@ -450,6 +477,7 @@ std::string SDSvrParams::to_string() const {
         << "  max_pending_jobs: " << max_pending_jobs << ",\n"
         << "  completed_ttl_seconds: " << completed_ttl_seconds << ",\n"
         << "  serve_html_path: \"" << serve_html_path << "\",\n"
+        << "  api_key: " << (api_key.empty() ? "none" : "set") << ",\n"
         << "}";
     return oss.str();
 }
diff --git a/examples/server/runtime.h b/examples/server/runtime.h
index abb9766..e72e70e 100644
--- a/examples/server/runtime.h
+++ b/examples/server/runtime.h
@@ -25,6 +25,9 @@ struct SDSvrParams {
     int max_pending_jobs      = 64;
     int completed_ttl_seconds = 600;
     std::string serve_html_path;
+    // A bearer token every request must carry; empty serves without one.
+    std::string api_key;
+    std::string api_key_file;
     std::vector<std::string> model_dirs;
     bool normal_exit         = false;
     sd_log_level_t log_level = SD_LOG_INFO;
-- 
